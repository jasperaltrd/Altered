from flask import Flask, render_template

from flask_socketio import SocketIO, emit

import requests

import time

from threading import Thread



app = Flask(__name__)

app.config['SECRET_KEY'] = 'secret!'

socketio = SocketIO(app)



# Simulated trader profiles and API integration

TRADERS = [

    {"id": 1, "name": "John Doe", "symbol": "AAPL"},

    {"id": 2, "name": "Jane Smith", "symbol": "TSLA"},

]



# Fetch real-time stock data (use any trading API)

def fetch_stock_data(symbol):

    # Example API integration (replace with your API key)

    url = f"https://www.alphavantage.co/query?function=TIME_SERIES_INTRADAY&symbol={symbol}&interval=1min&apikey=YOUR_API_KEY"

    response = requests.get(url).json()

    try:

        # Parse data for the latest price

        latest_data = list(response["Time Series (1min)"].values())[0]

        return {"price": float(latest_data["1. open"]), "volume": int(latest_data["5. volume"])}

    except (KeyError, IndexError):

        return {"price": 0, "volume": 0}



# Background task to broadcast data every second

def background_task():

    while True:

        updates = []

        for trader in TRADERS:

            data = fetch_stock_data(trader["symbol"])

            updates.append({

                "name": trader["name"],

                "symbol": trader["symbol"],

                "price": data["price"],

                "volume": data["volume"],

            })

        # Emit data to the front-end

        socketio.emit("update_data", {"traders": updates})

        time.sleep(1)



@app.route("/")

def index():

    return render_template("index.html", traders=TRADERS)



if __name__ == "__main__":

    # Start background task in a separate thread

    socketio.start_background_task(target=background_task)

    socketio.run(app, debug=True)



