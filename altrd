const socket = io.connect(window.location.origin);



// Dynamic trader cards

const traderDataDiv = document.getElementById("trader-data");



// Chart setup

const ctx = document.getElementById("priceChart").getContext("2d");

const priceChart = new Chart(ctx, {

  type: "line",

  data: {

    labels: [],

    datasets: [],

  },

  options: {

    responsive: true,

    plugins: {

      legend: { position: "top" },

    },

  },

});



// Handle updates from the server

socket.on("update_data", (data) => {

  traderDataDiv.innerHTML = ""; // Clear existing cards

  const labels = [];

  const datasets = [];



  data.traders.forEach((trader) => {

    // Update trader cards

    const card = document.createElement("div");

    card.className = "trader-card";

    card.innerHTML = `

      <h3>${trader.name} (${trader.symbol})</h3>

      <p>Price: $${trader.price.toFixed(2)}</p>

      <p>Volume: ${trader.volume}</p>

    `;

    traderDataDiv.appendChild(card);



    // Update chart data

    labels.push(trader.symbol);

    datasets.push({

      label: trader.name,

      data: [trader.price],

      borderColor: "#" + Math.floor(Math.random() * 16777215).toString(16),

      fill: false,

    });

  });



  // Refresh chart

  priceChart.data.labels = labels;

  priceChart.data.datasets = datasets;

  priceChart.update();

});



